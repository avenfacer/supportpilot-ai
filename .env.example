# Copy to .env and adjust. Never commit a real .env file.

APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL + pgvector (see docker-compose.yml). Dev-only credentials.
DATABASE_URL=postgresql+psycopg://supportpilot:supportpilot@localhost:5433/supportpilot
# Used only by the integration test suite.
TEST_DATABASE_URL=postgresql+psycopg://supportpilot:supportpilot@localhost:5433/supportpilot_test

# Providers: "fake" (deterministic, free, offline) or "openai" (requires OPENAI_API_KEY).
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TIMEOUT_SECONDS=20
EMBEDDING_TIMEOUT_SECONDS=20

# Mock order API (synthetic data). Failure mode: none | timeout | unavailable
ORDER_API_TIMEOUT_SECONDS=3
ORDER_API_MAX_ATTEMPTS=2
MOCK_ORDER_FAILURE_MODE=none

# Retrieval tuning. Leave RETRIEVAL_MIN_SCORE empty to use the per-provider default.
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=

# DEMO-ONLY identity: trusts the X-Demo-Customer-Id header. Disable in any real deployment.
ENABLE_DEMO_AUTH=true

# Admin HTTP endpoints (ingestion, source listing). Off by default; prefer the CLI scripts.
ENABLE_ADMIN_ENDPOINTS=false
ADMIN_TOKEN=
